# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Printed by `npm run spike`; enables the sandbox e2e test
PAYPAL_VAULT_ID=
# Open-weight model for the intent check, served via OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=
# Any OpenRouter model id that supports structured outputs. Default: moonshotai/kimi-k3
# Free option (no credits needed): nvidia/nemotron-3-super-120b-a12b:free
LEASH_MODEL=moonshotai/kimi-k3
# Gateway
LEASH_AGENT_KEY=change-me-agent
LEASH_OWNER_KEY=change-me-owner
# Owner passcode the browser UI logs in with (min 8 chars). Make it random, not a word: `openssl rand -base64 12`
LEASH_UI_PASSCODE=
# HMAC secret for the owner session cookie (min 32 chars, e.g. `openssl rand -hex 32`)
LEASH_SESSION_SECRET=
PUBLIC_URL=http://localhost:8787
PORT=8787
LEASH_DB_PATH=leash.db
# Channel3 product search (trychannel3.com)
CHANNEL3_API_KEY=
# Scout (shopping agent). Optional model override; falls back to LEASH_MODEL
SCOUT_MODEL=
# Where Scout's agent-key client reaches the gateway. Default: http://127.0.0.1:${PORT}
GATEWAY_INTERNAL_URL=
